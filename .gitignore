
# ============================================================
# LLM-SFT-RL-Learning
# Git ignore rules for TRL, SFT, LoRA, GRPO and evaluation
# ============================================================

# ------------------------------------------------------------
# 1. General temporary files
# ------------------------------------------------------------
*.bak
*.log
*~
~*
_tmp*
tmp*
tags
.last_checked
*.swp
*.swo

# ------------------------------------------------------------
# 2. Python caches and compiled files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/

# ------------------------------------------------------------
# 3. Python packaging and build outputs
# ------------------------------------------------------------
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
.installed.cfg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# 4. Python / Conda environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
conda-env/
.conda/
.python-version

# ------------------------------------------------------------
# 5. Secrets and local configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
token.json

# ------------------------------------------------------------
# 6. LLM model weights and adapters
# ------------------------------------------------------------
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.gguf.*

# Generated model directories
models/
pretrained_models/
downloaded_models/
adapters/
lora_adapters/
merged_models/

# ------------------------------------------------------------
# 7. SFT / RL training checkpoints and outputs
# ------------------------------------------------------------
checkpoint-*/
checkpoints/
outputs/
output/
runs/
train_outputs/
sft_outputs/
grpo_outputs/
dpo_outputs/
trainer_state.json

# ------------------------------------------------------------
# 8. Hugging Face caches
# ------------------------------------------------------------
huggingface/
hf_cache/
hf_home/
transformers_cache/
datasets_cache/
.huggingface/

# ------------------------------------------------------------
# 9. Training logs and tracking
# ------------------------------------------------------------
wandb/
tensorboard/
lightning_logs/
mlruns/
events.out.tfevents.*

# ------------------------------------------------------------
# 10. Local and generated datasets
# ------------------------------------------------------------
data/raw/
data/cache/
data/processed/
data/downloads/
datasets/raw/
datasets/cache/
datasets/processed/

# Keep small reproducible examples and metadata
!data/examples/
!datasets/examples/

# ------------------------------------------------------------
# 11. Notebook / experiment caches
# ------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# ------------------------------------------------------------
# 12. Unit tests and coverage
# ------------------------------------------------------------
htmlcov/
.tox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover

# ------------------------------------------------------------
# 13. IDE / OS files
# ------------------------------------------------------------
.idea/
.vscode/
.DS_Store
.DS_Store?
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------
# 14. Framework-specific generated files
# ------------------------------------------------------------
local_settings.py
instance/
.webassets-cache/
.scrapy/
celerybeat-schedule
*.mo
*.pot
*.sage.py
.spyderproject
.spyproject
.ropeproject
target/
site/

# ------------------------------------------------------------
# 15. Documentation build files
# ------------------------------------------------------------
docs/_build/
docs_src/.last_checked
docs_src/fastai
tools/fastai
checklink/cookies.txt

# ------------------------------------------------------------
# 16. TRL upstream-specific rules
# ------------------------------------------------------------
.gitattributes
.gitconfig
nbs/wandb/
uv.lock
/.claude/skills
/.agents/skills/local-*/

# ------------------------------------------------------------
# 17. Files intentionally kept in Git
# ------------------------------------------------------------
# README.md
# LICENSE
# pyproject.toml
# requirements*.txt
# configs/*.yaml
# scripts/*.py
# evaluation/*.py
# results/*.csv
# data/examples/*.jsonl
